build
# twine<7 hardcodes the valid Metadata-Version list at <=2.4, so `twine check`
# rejects wheels built by current hatchling (which stamps Metadata-Version 2.5).
# twine>=7 drops that hardcode and validates via packaging. Floor it so the
# build lock can't regress to a version that fails the publish's Verify step.
twine>=7.0.0

# Transitive CVE floors (mirror of [tool.uv].constraint-dependencies in
# pyproject.toml; build-env doesn't read pyproject.toml so the pins must
# be repeated here)
cryptography>=50.0.0  # PYSEC-2026-3552 (was >=48.0.1 for GHSA-537c-gmf6-5ccf)
idna>=3.15      # CVE-2026-45409
urllib3>=2.7.0  # CVE-2026-44431 + CVE-2026-44432
